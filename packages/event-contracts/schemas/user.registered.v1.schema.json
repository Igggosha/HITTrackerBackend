{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user.registered v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "user.registered"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "integer"
        },
        "method": {
          "enum": ["email", "google"]
        },
        "registeredAt": {
          "type": "string"
        }
      },
      "required": ["userId", "method", "registeredAt"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurredAt",
    "aggregateType",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false
}
