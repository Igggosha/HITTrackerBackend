# Database Configuration
# Local-only configuration. Copy this file to `.env` and replace every
# `change_me` value. Never commit the resulting `.env` file.
#
# When running `docker compose up`, Compose overrides DATABASE_URL inside the
# API container and connects it to PostgreSQL at `postgres:5432` internally.
# This localhost URL is only for running Nest directly on the host.
DATABASE_URL=postgres://postgres:change_me@localhost:5432/nestdb
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=nestdb
DB_SSL=false

# App & Auth Secrets
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
OAUTH_SESSION_SECRET=your_oauth_session_secret_here

# Google Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Redirection target for Expo Web
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8081

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_google_app_password
MAIL_FROM="HitTracker <your_email@gmail.com>"
