# Database Configuration
# Local-only configuration. Copy this file to `.env` and replace every
# `change_me` value. Never commit the resulting `.env` file.
#
# When running `docker compose up`, Compose overrides DATABASE_URL inside the
# API container and connects it to PostgreSQL at `postgres:5432` internally.
# This localhost URL is only for running Nest directly on the host.
DATABASE_URL=postgres://postgres:change_me@localhost:5432/nestdb
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=nestdb
DB_SSL=false

# App & Auth Secrets
PORT=3000
# Comma-separated browser origins. Use only your HTTPS domains in production.
CORS_ORIGINS=http://localhost:5173
# Set both before building the optional edge frontend. They must match the
# public tunnel hostnames and the EAS production environment variables.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WEB_URL=https://app.example.com
JWT_SECRET=your_jwt_secret_key_here
OAUTH_SESSION_SECRET=your_oauth_session_secret_here
# How long a previous username remains reserved for its owner after a change.
# Як довго попереднє ім'я користувача залишається зарезервованим за власником після зміни.
USERNAME_RESERVATION_MINUTES=25

# Google Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth redirection targets
# Web URL must match the port used by the Expo web script.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/google/callback
# Must match the `expo.scheme` in hit-tracker-mobile/app.json.
OAUTH_MOBILE_REDIRECT_URL=hit-tracker-mobile://auth/google/callback
FRONTEND_URL=http://localhost:5173

# Optional local credential for the background Cloudflare Tunnel connector.
# Leave blank in this public template. Never commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_google_app_password
MAIL_FROM="HitTracker <your_email@gmail.com>"

# ============================ Object Storage ============================
# MinIO speaks the S3 API, so these are ordinary S3 settings. Leave S3_BUCKET
# empty to run the API without storage: it still boots and the media endpoints
# answer 503 STORAGE_UNAVAILABLE.
#
# Endpoint the API calls inside Docker. MinIO intentionally has no host ports.
S3_ENDPOINT=http://minio:9000
# Endpoint presigned URLs are signed for, i.e. the one a phone or browser can
# actually reach. A SigV4 signature is bound to this host, so it must match the
# URL the client requests. Behind the tunnel use your public files hostname.
S3_PUBLIC_ENDPOINT=https://files.example.com
S3_REGION=us-east-1
S3_BUCKET=hit-tracker
# Bucket-scoped service account created by docker/minio-init.sh.
# It must differ from MINIO_ROOT_USER and must not be a placeholder.
S3_ACCESS_KEY_ID=hit-tracker-api
S3_SECRET_ACCESS_KEY=change_me_storage_secret
# MinIO has no wildcard DNS, so keep path-style addressing on.
S3_FORCE_PATH_STYLE=true
# Key prefixes. They appear in the bucket policy, so change both places at once.
S3_UPLOAD_PREFIX=uploads
S3_TEMP_PREFIX=tmp
# Days before objects under S3_TEMP_PREFIX are expired by the lifecycle rule.
S3_TEMP_EXPIRY_DAYS=1
# Lifetime of a presigned download URL, 60..604800 seconds.
S3_PRESIGNED_URL_TTL_SECONDS=900
# Largest accepted upload, in bytes (10 MB). The hard request cap is 50 MB.
MAX_UPLOAD_BYTES=10485760
# Longest edge of a stored image, in pixels. Avatars are cropped to a square.
AVATAR_MAX_DIMENSION=512
EXERCISE_IMAGE_MAX_DIMENSION=1280
# WebP quality, 40..100.
IMAGE_QUALITY=82

# MinIO administration, used by docker compose only.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root_password
# MinIO's built-in cleanup for abandoned multipart uploads.
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h
# Endpoint the API uses inside the Compose network.
S3_INTERNAL_ENDPOINT=http://minio:9000
# MinIO server is built from the pinned official source release because the
# patched release is source-only. Change the tag and commit together.
MINIO_IMAGE_TAG=RELEASE.2025-10-15T17-29-55Z
MINIO_SOURCE_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
# Pinned MinIO client image used only for bucket bootstrap.
MINIO_MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z
