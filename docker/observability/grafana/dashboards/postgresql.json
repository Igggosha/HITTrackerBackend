{
  "title": "PostgreSQL",
  "uid": "postgresql",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id": 1, "title": "Connections", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "pg_stat_activity_count", "legendFormat": "connections"}]},
    {"id": 2, "title": "Transactions per second", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "commits/s"}, {"expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "rollbacks/s"}]},
    {"id": 3, "title": "Cache hit ratio", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "rate(pg_stat_database_blks_hit[5m]) / clamp_min(rate(pg_stat_database_blks_hit[5m]) + rate(pg_stat_database_blks_read[5m]), 1)", "legendFormat": "{{datname}}"}]},
    {"id": 4, "title": "Database size", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "pg_database_size_bytes", "legendFormat": "{{datname}}"}]},
    {"id": 5, "title": "Replication lag (replica exporter required)", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}, "targets": [{"expr": "pg_replication_lag", "legendFormat": "{{application_name}}"}]}
  ]
}
